{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deploy-config.schema.json",
  "title": ".github/configs/deploy-config.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaults", "artifacts"],
  "properties": {
    "defaults": { "$ref": "#/$defs/settings", "required": ["driver"] },
    "accounts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/envName" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,19}$" }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/artifactName" },
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "envs": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/envName" },
      "additionalProperties": {
        "allOf": [{ "$ref": "#/$defs/settings" }],
        "properties": {
          "reviewers": {
            "description": "quem aprova o deploy neste ambiente (aplicado pelo bootstrap, nao a cada execucao)",
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "user": { "type": "string" },
                "team": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
              }
            }
          },
          "waitTimer": { "description": "minutos de espera antes do deploy", "type": "integer", "minimum": 0, "maximum": 43200 },
          "preventSelfReview": { "description": "quem disparou a execucao nao aprova o proprio deploy (padrao: true; false so com uma pessoa)", "type": "boolean" },
          "artifacts": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    }
  },
  "$defs": {
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" },
    "artifactName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$" },
    "driver": { "enum": ["kubernetes", "gitops-pr", "ecs", "flyway"] },
    "settings": {
      "type": "object",
      "properties": {
        "driver": { "$ref": "#/$defs/driver" },
        "kubernetes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cluster": { "enum": ["kind", "aks", "kubeconfig"] },
            "resourceGroup": { "type": "string" },
            "clusterName": { "type": "string" },
            "namespace": { "type": "string" },
            "secretStore": { "description": "ClusterSecretStore do External Secrets Operator", "type": "string" }
          }
        },
        "gitops": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string" },
            "branch": { "type": "string", "minLength": 1 },
            "mode": { "enum": ["pr", "commit"] },
            "path": { "type": "string" }
          }
        },
        "ecs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cluster": { "type": "string" }
          }
        },
        "flyway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ephemeral": { "description": "valida as migracoes num banco descartavel (laboratorio, PR)", "type": "boolean" }
          }
        },
        "reviewers": true,
        "waitTimer": true,
        "preventSelfReview": true,
        "artifacts": { "type": "object" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": { "$ref": "#/$defs/driver" },
        "order": { "description": "ordem dentro do ambiente (menor primeiro; padrao 100)", "type": "integer", "minimum": 0, "maximum": 999 },
        "containerPort": { "description": "sem porta = worker: sem Service, sem probe, sem smoke test", "type": "integer", "minimum": 1, "maximum": 65535 },
        "healthPath": { "type": "string", "pattern": "^/" },
        "args": { "type": "array", "items": { "type": "string" } },
        "replicas": { "type": "integer", "minimum": 0, "maximum": 50 },
        "cpu": { "type": "integer", "minimum": 50 },
        "memory": { "type": "integer", "minimum": 64 },
        "rolloutTimeout": { "description": "segundos para o rollout estabilizar (padrao 180)", "type": "integer", "minimum": 30, "maximum": 1800 },
        "secrets": {
          "description": "nomes dos segredos, resolvidos no cofre em <app>/<env>/<NOME>",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,62}$" }
        },
        "service": { "type": "string" },
        "flyway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "database": { "enum": ["postgresql"] },
            "locations": { "type": "string" },
            "schema": { "type": "string" }
          }
        }
      }
    }
  }
}
