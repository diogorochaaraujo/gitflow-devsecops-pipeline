{
  "name": "tags-de-versao",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~ALL"], "exclude": [] },
    "repository_property": { "include": [{ "name": "pipeline", "property_values": ["managed"] }], "exclude": [] }
  },
  "bypass_actors": [
    { "actor_type": "Integration", "actor_id": "__RELEASE_APP_ID__", "bypass_mode": "always" }
  ],
  "rules": [
    { "type": "creation" },
    { "type": "update" },
    { "type": "deletion" }
  ]
}
