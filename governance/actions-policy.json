{
  "_comentario": "Politica de Actions da organizacao: so actions da propria org e uma lista curta de terceiros, sempre por SHA. A blocklist (prefixo !) e o freio de emergencia num incidente de supply chain.",
  "permissions": {
    "enabled_repositories": "all",
    "allowed_actions": "selected",
    "sha_pinning_required": true
  },
  "selected_actions": {
    "github_owned_allowed": true,
    "verified_allowed": false,
    "patterns_allowed": [
      "docker/login-action@*",
      "docker/setup-buildx-action@*",
      "docker/build-push-action@*",
      "helm/kind-action@*",
      "aws-actions/configure-aws-credentials@*",
      "azure/login@*",
      "azure/setup-kubectl@*"
    ]
  },
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_pr_workflows_private_repos": {
    "run_workflows_from_fork_pull_requests": false,
    "send_write_tokens_to_workflows": false,
    "send_secrets_and_variables": false,
    "require_approval_for_fork_pr_workflows": true
  }
}
